# LcvSearch 环境变量模板：cp .env.example .env 后按需修改
# 全部变量都有内置默认值，不配置也能跑通本机开发态。

# ---------- Django ----------
# 生产环境务必改成随机长字符串
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# 允许的主机名，逗号分隔（生产环境 DEBUG=False 时必填）
DJANGO_ALLOWED_HOSTS=

# ---------- Elasticsearch ----------
# Django 与 Scrapy 统一使用 ES_URL；Docker 部署时改为 http://elasticsearch:9200
ES_URL=http://127.0.0.1:9200
ES_INDEX=quotes

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- AI 大模型 ----------
# 对话/抽取：DeepSeek（OpenAI 兼容协议）。不配置时爬虫降级为纯选择器
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.deepseek.com
AI_LLM_MODEL=deepseek-v4-flash

# ---------- 可选 ----------
# 住宅代理列表，逗号分隔（http://user:pass@host:port）
AI_PROXIES=
# 设置后所有写操作与 AI 问答接口要求请求头 X-API-Token 匹配（留空 = 不启用鉴权）
API_TOKEN=
# 追加允许跨域的前端来源，逗号分隔
FRONTEND_ORIGINS=

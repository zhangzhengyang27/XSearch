# XSearch 环境变量模板：cp .env.example .env 后按需修改
# 本机开发态：下面所有项都有默认值，不配置也能跑（DEBUG=True + 仅开发态密钥）。
# 生产部署（docker-compose.prod.yml）：Django 三项为必填，缺失时后端会拒绝启动。

# ---------- Django ----------
# 生产必填。生成：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# prod compose 已写死 False；本机需要调试页时显式设 True
DJANGO_DEBUG=True
# 生产必填：对外域名，逗号分隔（DEBUG=False 且留空 = 拒绝启动）
DJANGO_ALLOWED_HOSTS=
# 是否采信 X-Forwarded-For 取客户端 IP（管理员登录限速用）；代理不受信时设 False
DJANGO_TRUST_PROXY_HEADER=True

# ---------- Elasticsearch ----------
# Django 与 Scrapy 统一使用 ES_URL；Docker 部署时改为 http://elasticsearch:9200
ES_URL=http://127.0.0.1:9200
ES_INDEX=quotes

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 管理员账号（采集管理 / 数据管理页） ----------
# 建议写在 XSearch/local_settings.py（已 gitignore，参考 .example），
# 文件配置优先级高于这里。口令过弱会在后端启动日志里告警。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- 可选 ----------
# 采集失败 / 采集 0 条 / 定时任务 misfire 的告警邮箱。
# QQ/163 要填"SMTP 授权码"，不是登录密码；ENABLED 不为 True 时整条通道是 no-op。
ALERT_EMAIL_ENABLED=False
ALERT_SMTP_HOST=smtp.qq.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# 面向非浏览器客户端（脚本/内部调用）的额外令牌；留空 = 不启用。
# 浏览器侧的写接口一律走管理员登录，不依赖它，所以不要打进前端构建产物。
API_TOKEN=
# 住宅代理列表，逗号分隔（http://user:pass@host:port），爬虫按请求轮换
AI_PROXIES=
# 追加允许跨域的前端来源，逗号分隔
FRONTEND_ORIGINS=
